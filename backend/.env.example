PORT=4000
NODE_ENV=production

# PostgreSQL
DATABASE_URL=postgresql://recoveriq_admin:your_db_password@your-db-host:5432/recoveriq_prod?sslmode=require

# Redis
REDIS_URL=rediss://default:your_redis_password@your-redis-host:6379

# Kafka
KAFKA_BROKERS=your-kafka-broker:9092
KAFKA_CLIENT_ID=recoveriq-backend-prod
KAFKA_PAYMENT_TOPIC=payment-events
KAFKA_OUTCOME_TOPIC=recovery-outcomes
KAFKA_DLQ_TOPIC=dead-letter-events
KAFKA_RECOVERY_GROUP=recovery-worker-group-prod
KAFKA_OUTCOME_GROUP=outcome-worker-group-prod

# Internal Microservices
GENAI_SERVICE_URL=http://genai-service:8001
ML_SERVICE_URL=http://ml-service:8000

# Security Tokens (Generated via openssl rand -hex 32)
JWT_SECRET=your_32_char_minimum_random_jwt_secret_token_here
RECOVERY_LINK_SECRET=your_32_char_minimum_random_signing_secret_here
INTERNAL_SERVICE_TOKEN=your_32_char_minimum_random_service_boundary_token_here
ML_INTERNAL_TOKEN=your_32_char_minimum_random_service_boundary_token_here
GENAI_INTERNAL_TOKEN=your_32_char_minimum_random_service_boundary_token_here

# Frontend URL
FRONTEND_URL=https://dashboard.recoveriq.yourdomain.com

# Payment Gateways (Razorpay)
RAZORPAY_KEY_ID=rzp_live_your_actual_key_id
RAZORPAY_KEY_SECRET=your_actual_razorpay_secret
RAZORPAY_WEBHOOK_SECRET=your_actual_razorpay_webhook_secret

# AWS S3 Storage
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=AKIA_YOUR_AWS_ACCESS_KEY_ID
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key_here
AWS_S3_BUCKET=recoveriq-audit-exports-prod
