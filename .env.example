# ==============================================================================
# RecoverIQ - Master Production & Cloud Deployment Environment Configuration
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Environment Mode
# ------------------------------------------------------------------------------
NODE_ENV=production
ENVIRONMENT=production

# ------------------------------------------------------------------------------
# 2. PostgreSQL Database (AWS RDS / Neon / Supabase / Self-Hosted)
# ------------------------------------------------------------------------------
# Format: postgresql://[user]:[password]@[host]:[port]/[database]?sslmode=require
DATABASE_URL=postgresql://recoveriq_admin:your_secure_db_password@your-postgres-host:5432/recoveriq_prod?sslmode=require
POSTGRES_USER=recoveriq_admin
POSTGRES_PASSWORD=your_secure_db_password
POSTGRES_DB=recoveriq_prod

# ------------------------------------------------------------------------------
# 3. Redis Cache & Idempotency Store (AWS ElastiCache / Upstash / Redis Cloud)
# ------------------------------------------------------------------------------
# Format: rediss://default:[password]@[host]:[port] (use rediss:// with TLS in production)
REDIS_URL=rediss://default:your_redis_password@your-redis-host:6379

# ------------------------------------------------------------------------------
# 4. Kafka / Redpanda Streaming Broker (AWS MSK / Confluent Cloud / Redpanda)
# ------------------------------------------------------------------------------
# Comma-separated list of broker endpoints
KAFKA_BROKERS=your-kafka-broker-1:9092,your-kafka-broker-2:9092
KAFKA_CLIENT_ID=recoveriq-backend-prod
KAFKA_PAYMENT_TOPIC=payment-events
KAFKA_OUTCOME_TOPIC=recovery-outcomes
KAFKA_DLQ_TOPIC=dead-letter-events
KAFKA_RECOVERY_GROUP=recovery-worker-group-prod
KAFKA_OUTCOME_GROUP=outcome-worker-group-prod

# ------------------------------------------------------------------------------
# 5. AWS S3 / MinIO Cloud Storage (Audit Logs & Decision Snapshots)
# ------------------------------------------------------------------------------
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=AKIA_YOUR_AWS_ACCESS_KEY_ID
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key_here
AWS_S3_BUCKET=recoveriq-audit-exports-prod
# For MinIO or custom S3 endpoint (leave empty for AWS S3):
MINIO_ENDPOINT=
MINIO_PORT=9000
MINIO_USE_SSL=true

# ------------------------------------------------------------------------------
# 6. Qdrant Vector Search Engine (Qdrant Cloud / Managed Cluster)
# ------------------------------------------------------------------------------
QDRANT_URL=https://your-qdrant-cluster-url.cloud.qdrant.io:6333
QDRANT_API_KEY=your_qdrant_api_key_here

# ------------------------------------------------------------------------------
# 7. LLM & GenAI API (OpenAI)
# ------------------------------------------------------------------------------
OPENAI_API_KEY=sk-proj-your_actual_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini

# ------------------------------------------------------------------------------
# 8. Payment Gateway (Razorpay Live / Test Mode)
# ------------------------------------------------------------------------------
RAZORPAY_KEY_ID=rzp_live_your_actual_key_id
RAZORPAY_KEY_SECRET=your_actual_razorpay_secret
RAZORPAY_WEBHOOK_SECRET=your_actual_razorpay_webhook_secret

# ------------------------------------------------------------------------------
# 9. Cryptographic Secrets & Inter-Service Tokens
# (Generate with: openssl rand -hex 32)
# ------------------------------------------------------------------------------
JWT_SECRET=your_32_char_minimum_random_jwt_secret_token_here
RECOVERY_LINK_SECRET=your_32_char_minimum_random_signing_secret_here
INTERNAL_SERVICE_TOKEN=your_32_char_minimum_random_service_boundary_token_here
ML_INTERNAL_TOKEN=your_32_char_minimum_random_service_boundary_token_here
GENAI_INTERNAL_TOKEN=your_32_char_minimum_random_service_boundary_token_here

# ------------------------------------------------------------------------------
# 10. Service URLs & Networking
# ------------------------------------------------------------------------------
BACKEND_URL=https://api.recoveriq.yourdomain.com
FRONTEND_URL=https://dashboard.recoveriq.yourdomain.com
NEXT_PUBLIC_BACKEND_URL=https://api.recoveriq.yourdomain.com/api
ML_SERVICE_URL=http://ml-service:8000
GENAI_SERVICE_URL=http://genai-service:8001
